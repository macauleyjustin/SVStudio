{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://satella.dev/schemas/1.0.0/model.schema.json",
  "title": "Satella Avatar Model Layout",
  "type": "object",
  "additionalProperties": false,
  "required": ["textures", "drawables"],
  "properties": {
    "textures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "file", "width", "height"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "file": { "type": "string", "minLength": 1 },
          "width": { "type": "integer", "minimum": 1, "maximum": 8192 },
          "height": { "type": "integer", "minimum": 1, "maximum": 8192 },
          "alphaMode": { "type": "string", "enum": ["straight", "premultiplied"] }
        }
      }
    },
    "parts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "parent": { "type": ["string", "null"] },
          "visible": { "type": "boolean" },
          "opacity": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "drawables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "mesh", "drawOrder"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "part": { "type": ["string", "null"] },
          "mesh": { "type": "string", "minLength": 1 },
          "drawOrder": { "type": "number" },
          "visible": { "type": "boolean" },
          "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
          "blendMode": { "type": "string", "enum": ["normal", "additive", "multiply", "screen"] },
          "doubleSided": { "type": "boolean" }
        }
      }
    }
  }
}
