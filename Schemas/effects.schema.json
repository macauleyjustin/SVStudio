{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://satella.dev/schemas/1.0.0/effects.schema.json",
  "title": "Satella Animated Visual Effects",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "layers"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "placement", "regions", "particleCount", "colors"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "type": "string", "enum": ["miasma", "aura_wisp", "particles"] },
          "placement": { "type": "string", "enum": ["behind_avatar", "above_cloak", "foreground"] },
          "blendMode": { "type": "string", "enum": ["alpha", "additive", "screen"] },
          "chromaSafe": { "type": "boolean" },
          "texture": { "type": ["string", "null"] },
          "particleCount": { "type": "integer", "minimum": 1, "maximum": 512 },
          "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
          "riseSpeed": { "type": "number" },
          "driftX": { "type": "number" },
          "turbulence": { "type": "number", "minimum": 0 },
          "swirlFrequency": { "type": "number", "minimum": 0 },
          "swirlAmplitude": { "type": "number", "minimum": 0 },
          "sizeRange": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number", "exclusiveMinimum": 0 } },
          "lifeRange": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number", "exclusiveMinimum": 0 } },
          "intensityParam": { "type": ["string", "null"] },
          "followDeformer": { "type": ["string", "null"] },
          "exclusionBoxes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["x", "y", "width", "height"],
              "properties": {
                "x": { "type": "number" },
                "y": { "type": "number" },
                "width": { "type": "number" },
                "height": { "type": "number" }
              }
            }
          },
          "colors": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          },
          "regions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["x", "y", "width", "height"],
              "properties": {
                "x": { "type": "number" },
                "y": { "type": "number" },
                "width": { "type": "number", "exclusiveMinimum": 0 },
                "height": { "type": "number", "exclusiveMinimum": 0 },
                "weight": { "type": "number", "exclusiveMinimum": 0 }
              }
            }
          }
        }
      }
    }
  }
}
