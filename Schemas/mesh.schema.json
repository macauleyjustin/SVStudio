{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://satella.dev/schemas/1.0.0/mesh.schema.json",
  "title": "Satella Mesh Geometry",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "texture", "vertices", "uv", "triangles"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "texture": { "type": "string", "minLength": 1 },
    "parent": { "type": ["string", "null"] },
    "part": { "type": ["string", "null"] },
    "drawOrder": { "type": "number" },
    "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
    "blendMode": { "type": "string", "enum": ["normal", "additive", "multiply", "screen"] },
    "clipMasks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "invertedMask": { "type": "boolean" },
    "uvClipRect": {
      "type": ["array", "null"],
      "minItems": 4,
      "maxItems": 4,
      "items": { "type": "number", "minimum": 0, "maximum": 1 }
    },
    "vertices": {
      "type": "array",
      "minItems": 3,
      "maxItems": 65535,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": { "type": "number" }
      }
    },
    "uv": {
      "type": "array",
      "minItems": 3,
      "maxItems": 65535,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": { "type": "number", "minimum": -0.05, "maximum": 1.05 }
      }
    },
    "triangles": {
      "type": "array",
      "minItems": 3,
      "maxItems": 300000,
      "items": { "type": "integer", "minimum": 0 }
    }
  }
}
