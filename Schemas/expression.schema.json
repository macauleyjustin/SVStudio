{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://satella.dev/schemas/1.0.0/expression.schema.json",
  "title": "Satella Facial Expression",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "parameters"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "fadeInSeconds": { "type": "number", "minimum": 0 },
    "fadeOutSeconds": { "type": "number", "minimum": 0 },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["parameter", "value", "blend"],
        "properties": {
          "parameter": { "type": "string" },
          "value": { "type": "number" },
          "blend": { "type": "string", "enum": ["overwrite", "add", "multiply"] }
        }
      }
    }
  }
}
